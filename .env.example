# Neon connection string (SQL Editor > Connection string trong Neon Console).
# Dùng connection string Neon đã cấp cho sandbox từ trước, hoặc tạo DB mới và chạy db/schema.sql.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret dùng để Webex Flow xác thực khi gọi POST /api/webex/events
# Flow gửi header: x-api-secret: <giá trị này>
API_SECRET=replace-with-a-long-random-secret

# Basic Auth cho trang dashboard + API đọc/export (bảo vệ vì repo là public)
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-a-strong-password
